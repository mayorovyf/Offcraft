# Normalize text in Git; Windows launch scripts keep CRLF on checkout.
* text=auto
*.java text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
**/gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
