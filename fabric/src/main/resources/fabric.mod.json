{
  "schemaVersion": 1,
  "id": "offcraft",
  "version": "${version}",
  "name": "Offcraft",
  "description": "Hidden-window Minecraft client controlled through stdin.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["offcraft.fabric.OffcraftFabric"]
  },
  "mixins": ["offcraft.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
